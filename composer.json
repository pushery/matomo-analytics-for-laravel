{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pushery/matomo-analytics-for-laravel",
    "description": "Privacy-first Matomo analytics for Laravel with cookieless tracking, reports, Web Vitals, batching and bot filtering.",
    "keywords": [
        "laravel",
        "matomo",
        "analytics",
        "tracking",
        "privacy",
        "gdpr",
        "piwik",
        "web-analytics",
        "cookieless",
        "web-vitals",
        "reporting-api",
        "bot-detection"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/pushery/matomo-analytics-for-laravel",
    "authors": [
        {
            "name": "Pushery",
            "homepage": "https://www.pushery.com"
        }
    ],
    "support": {
        "issues": "https://github.com/pushery/matomo-analytics-for-laravel/issues",
        "source": "https://github.com/pushery/matomo-analytics-for-laravel",
        "docs": "https://docs.pushery.com/matomo-analytics-for-laravel/"
    },
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.0 || ^8.0",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/config": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/cookie": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/redis": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/translation": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "nesbot/carbon": "^3.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "3.12.2",
        "laravel/ai": "^1.0.1",
        "laravel/boost": "^2.10.1",
        "laravel/mcp": "^1.0.1",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.0",
        "matomo/device-detector": "^6.4",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "5.2.2",
        "pestphp/pest-plugin-rector": "5.0.4",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/phpstan": "2.2.16",
        "rector/rector": "2.6.7",
        "spaze/phpstan-disallowed-calls": "4.14.0"
    },
    "suggest": {
        "ext-pcntl": "Lets matomo:work stop between two runs on SIGTERM or SIGINT, instead of wherever the signal lands.",
        "ext-redis": "The phpredis client for the redis buffer driver; predis/predis serves it as well.",
        "matomo/device-detector": "Exhaustive, upstream-maintained bot detection across every category — wire DeviceDetectorBotDetector through the bots.detector config hook."
    },
    "autoload": {
        "psr-4": {
            "MatomoAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MatomoAnalytics\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "@php -d pcov.directory=. -d pcov.exclude='~/(vendor|tests|workbench)/~' vendor/bin/pest --coverage --min=100",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:browser": "pest tests/Browser",
        "test:integration": "pest tests/Integration",
        "test:performance": "pest tests/Performance",
        "test:database": "pest --testsuite=Postgres,MySql,Redis",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:test": "pint --test",
        "rector": "rector process",
        "rector:test": "rector process --dry-run",
        "mutate": "@php -d pcov.directory=src vendor/bin/pest --mutate --everything --covered-only --path=src --min=96",
        "mutate:detect": "@php -d pcov.directory=src vendor/bin/pest --mutate --everything --covered-only --path=src --parallel --processes=4 --min=96",
        "qa": [
            "@format:test",
            "@rector:test",
            "@analyse",
            "@test:type-coverage",
            "@test:coverage"
        ]
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MatomoAnalytics\\MatomoAnalyticsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
